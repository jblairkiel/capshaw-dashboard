# Copy to .env and fill in. Nothing here has a sensible default that a real
# deployment should keep, and the app refuses to start in production without
# SESSION_SECRET rather than signing sessions with a secret that is in the
# source history.
#
# The full list, including everything optional, is in README → Environment
# Variables.

# ─── Required in production ───────────────────────────────────────────────────

# Signs the session cookie. Generate one and keep it: changing it signs
# everybody out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ─── Strongly recommended ─────────────────────────────────────────────────────

# The owner account. Promoted to admin on every login, so there is always a way
# back in.
ADMIN_EMAIL=

# Question generation on the Bible Class tab.
ANTHROPIC_API_KEY=

# ─── Reading the church website ───────────────────────────────────────────────
# Without these the portal runs, but every scraped page stays empty.

CAPSHAW_MEMBER_USERNAME=
CAPSHAW_MEMBER_PASSWORD=

# ─── Sign-in providers ────────────────────────────────────────────────────────
# Email and password sign-in works without either of these.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Unset means messages queue in the outbox and are not sent. Until you are sure
# the right people are on the right lists, leave MAIL_REDIRECT_TO pointing at
# yourself: every message goes there instead of to the congregation.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REDIRECT_TO=

# ─── Livestreams ──────────────────────────────────────────────────────────────

YOUTUBE_CHANNEL=@CapshawChurch

# ─── Where the container keeps what it writes ─────────────────────────────────
# The image already points these at /data, which docker-compose.yml mounts a
# volume over. Only set them if you are running outside a container and want
# the data somewhere other than server/.

# CAPSHAW_DATA_DIR=/data
# CAPSHAW_UPLOAD_DIR=/data/uploads
