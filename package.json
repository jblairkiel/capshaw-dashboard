{
  "name": "capshaw-dashboard",
  "version": "1.0.0",
  "description": "Worship dashboard for Capshaw Church of Christ",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "install:all": "npm install && cd client && npm install",
    "test": "jest --testPathPattern=server/tests",
    "test:coverage": "jest --testPathPattern=server/tests --coverage",
    "test:client": "cd client && npm test",
    "test:client:coverage": "cd client && npm run test:coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "js-yaml": "4.3.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/server/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/server/tests/helpers/isolateData.js"
    ],
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/tests/**",
      "!server/data/**"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "json-summary"
    ]
  }
}
