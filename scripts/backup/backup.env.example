# Copy to /etc/capshaw-backup.env (chmod 600). Read by capshaw-backup.sh,
# capshaw-restore.sh and the systemd unit. See scripts/backup/README.md.

# Where the checkout with docker-compose.yml and .env lives.
APP_DIR=/var/www/capshaw-dashboard

# docker (the container deploy) or pm2 (the older process-manager deploy).
RUNNER=docker

# Local copies, newest KEEP_DAYS kept. Protects against a bad write today.
BACKUP_DIR=/var/backups/capshaw
KEEP_DAYS=14

# The off-server copy: an rclone remote and folder. Protects against losing
# the droplet itself. Use the encrypted ("crypt") remote from the README, so
# the storage provider only ever holds ciphertext. Empty = local copies only.
RCLONE_REMOTE=capshaw-offsite:
REMOTE_KEEP_DAYS=90

# Optional: a healthchecks.io (or similar) URL. Pinged after every good
# backup, and /fail after a bad one, so a silent stop gets an email.
HEALTHCHECK_URL=

# rclone reads its config from here when run by systemd as the deploy user.
# RCLONE_CONFIG=/home/deploy/.config/rclone/rclone.conf
